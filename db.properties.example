# =====================================================================
# Database Configuration Properties Template (db.properties.example)
# =====================================================================
# Copy this file to 'db.properties' and fill in your MySQL credentials:
#
# Alternatively, set Environment Variables:
#   DB_URL=jdbc:mysql://localhost:3306/library_db?...
#   DB_USER=root
#   DB_PASSWORD=your_password

db.url=jdbc:mysql://localhost:3306/library_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=your_mysql_password_here
db.timeout.seconds=5
